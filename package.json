{
  "name": "irusta-training-club",
  "version": "1.1.0",
  "private": true,
  "description": "App del Irusta Training Club (web + iOS + Android con Capacitor)",
  "scripts": {
    "android:add": "cap add android && bash native/patch-android.sh",
    "ios:add": "cap add ios && bash native/patch-ios.sh",
    "icons": "python3 native/make-resources.py && capacitor-assets generate --assetPath native/resources",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "6.1.2",
    "@capacitor/app": "6.0.1",
    "@capacitor/browser": "6.0.2",
    "@capacitor/core": "6.1.2",
    "@capacitor/ios": "6.1.2"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "6.1.2"
  }
}
